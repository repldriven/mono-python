source_up_if_exists
if has nix; then
  use flake .
else
  echo "nix not found — install it from https://nixos.org/download, then re-enter this directory"
fi

# uv owns .venv: sync it against uv.lock, then put its tools on PATH so
# pytest and ruff run without a `uv run` prefix. uv comes from the flake.
if has uv; then
  watch_file uv.lock pyproject.toml
  uv sync
  PATH_add .venv/bin
fi

# The rules agents load are a per-machine copy that tessl install
# writes from plugins/. A clone has none until it is laid down once.
if has just; then
  [ -f .tessl/RULES.md ] || just tessl-plugins-install
fi
